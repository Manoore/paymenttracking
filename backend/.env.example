NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (use a dedicated DB user with readWrite on this database only)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/capturehub?retryWrites=true&w=majority
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated browser origins allowed to call the API (your Vercel URL)
CORS_ORIGINS=http://localhost:3000
# Leave false: the first account can always register; after that signup is closed.
ALLOW_SIGNUP=false
MAX_UPLOAD_MB=15
# Shared secret for the reminders cron endpoint
CRON_SECRET=
# Optional: email reminders via Resend
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
WEB_APP_URL=http://localhost:3000
# Optional: browser push notifications. Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: encrypts API keys saved in the app. Set before rotating JWT secrets.
SECRETS_KEY=
